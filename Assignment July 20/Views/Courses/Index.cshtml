@model IEnumerable<StudentRegistration.Models.Course>
@{
    ViewData["Title"] = "Course Directory";
    var hasRegistered = ViewBag.HasRegisteredCourse == true;
    var registeredId = ViewBag.RegisteredCourseId as int?;
    var isStudent = ViewBag.IsStudent == true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 font-weight-bold mb-1">Available Courses</h1>
        <p class="text-secondary mb-0">Browse and enroll in our academic courses</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary-custom">
            <i class="bi bi-plus-lg me-2"></i>Add New Course
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="card glass-card p-5 text-center border-0">
        <div class="text-secondary mb-3">
            <i class="bi bi-journal-x" style="font-size: 3rem;"></i>
        </div>
        <h5>No Courses Available</h5>
        <p class="text-secondary text-opacity-75">There are currently no courses in the registry.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card glass-card h-100 border-0 d-flex flex-column justify-content-between">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-indigo bg-opacity-10 text-indigo px-3 py-2 rounded-pill font-weight-bold" style="font-size: 0.85rem;">
                                <i class="bi bi-award me-1"></i>@item.Credits Credits
                            </span>
                            @if (isStudent && registeredId == item.Id)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill font-weight-bold" style="font-size: 0.85rem;">
                                    <i class="bi bi-check-circle-fill me-1"></i>Registered
                                </span>
                            }
                        </div>
                        <h3 class="h5 card-title font-weight-bold mb-2">@item.Name</h3>
                        <p class="card-text text-secondary text-opacity-75" style="font-size: 0.92rem; line-height: 1.5;">
                            @item.Description
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary-custom flex-grow-1">
                                    <i class="bi bi-pencil-square me-1"></i>Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger flex-grow-1">
                                    <i class="bi bi-trash3 me-1"></i>Delete
                                </a>
                            </div>
                        }
                        else if (isStudent)
                        {
                            if (!hasRegistered)
                            {
                                <form asp-controller="Profile" asp-action="RegisterCourse" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="courseId" value="@item.Id" />
                                    <button type="submit" class="btn btn-primary-custom w-100">
                                        <i class="bi bi-plus-circle me-1"></i>Register for Course
                                    </button>
                                </form>
                            }
                            else if (registeredId != item.Id)
                            {
                                <button class="btn btn-secondary-custom w-100" disabled>
                                    Only One Registration Allowed
                                </button>
                            }
                        }
                        else if (User.Identity?.IsAuthenticated != true)
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-secondary-custom w-100">
                                Sign In to Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
