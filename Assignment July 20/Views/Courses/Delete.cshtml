@model StudentRegistration.Models.Course
@{
    ViewData["Title"] = "Delete Course";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card glass-card border-0 p-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="text-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                    </div>
                    <h2 class="font-weight-bold h4">Are you sure?</h2>
                    <p class="text-secondary text-opacity-75">You are about to delete this course from the system. This action cannot be undone.</p>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4 border">
                    <h4 class="h5 font-weight-bold text-dark mb-1">@Model.Name</h4>
                    <p class="text-secondary mb-2 small"><i class="bi bi-award me-1"></i>@Model.Credits Credits</p>
                    <p class="text-secondary mb-0 text-opacity-75" style="font-size: 0.9rem;">@Model.Description</p>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-3">
                        <a asp-action="Index" class="btn btn-secondary-custom flex-grow-1">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-danger flex-grow-1 font-weight-bold py-2">
                            Yes, Delete Course
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
