@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section glass-card p-5">
    <div class="row align-items-center">
        <div class="col-lg-8 mx-auto text-center">
            <h1 class="hero-title">Welcome to Student Registration Portal</h1>
            <p class="hero-subtitle">
                A secure, state-of-the-art platform for managing course enrollments, student records, and role-based operations using ASP.NET Core Identity.
            </p>
            <div class="d-flex justify-content-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Students" asp-action="Index" class="btn btn-primary-custom px-4 py-2">
                            <i class="bi bi-people-fill me-2"></i>Manage Students
                        </a>
                        <a asp-controller="Courses" asp-action="Index" class="btn btn-secondary-custom px-4 py-2">
                            <i class="bi bi-book-fill me-2"></i>Manage Courses
                        </a>
                    }
                    else if (User.IsInRole("Student"))
                    {
                        <a asp-controller="Profile" asp-action="Index" class="btn btn-primary-custom px-4 py-2">
                            <i class="bi bi-person-badge-fill me-2"></i>Go to Profile
                        </a>
                        <a asp-controller="Courses" asp-action="Index" class="btn btn-secondary-custom px-4 py-2">
                            <i class="bi bi-book-half me-2"></i>Browse Courses
                        </a>
                    }
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom px-4 py-2">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Get Started
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-secondary-custom px-4 py-2">
                        <i class="bi bi-person-plus-fill me-2"></i>Create Account
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4 g-4">
    <div class="col-md-4">
        <div class="card glass-card h-100 p-4 border-0">
            <div class="card-body text-center d-flex flex-column align-items-center">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary mb-3">
                    <i class="bi bi-shield-lock-fill fs-2"></i>
                </div>
                <h3 class="card-title h5 font-weight-bold">Authentication</h3>
                <p class="card-text text-secondary text-opacity-75">
                    Secure ASP.NET Core Identity engine managing password hashing, cookie-based sessions, and secure login workflows.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card glass-card h-100 p-4 border-0">
            <div class="card-body text-center d-flex flex-column align-items-center">
                <div class="bg-cyan bg-opacity-10 p-3 rounded-circle text-info mb-3">
                    <i class="bi bi-person-vcard-fill fs-2"></i>
                </div>
                <h3 class="card-title h5 font-weight-bold">Authorization</h3>
                <p class="card-text text-secondary text-opacity-75">
                    Role-Based Access Control (RBAC) ensuring only validated Students register for courses, and only Admins edit catalogs.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card glass-card h-100 p-4 border-0">
            <div class="card-body text-center d-flex flex-column align-items-center">
                <div class="bg-indigo bg-opacity-10 p-3 rounded-circle text-indigo mb-3">
                    <i class="bi bi-sliders fs-2"></i>
                </div>
                <h3 class="card-title h5 font-weight-bold">Dynamic Navigation</h3>
                <p class="card-text text-secondary text-opacity-75">
                    Interactive menus that automatically adjust depending on role and status, hiding student registration after enrollment.
                </p>
            </div>
        </div>
    </div>
</div>
