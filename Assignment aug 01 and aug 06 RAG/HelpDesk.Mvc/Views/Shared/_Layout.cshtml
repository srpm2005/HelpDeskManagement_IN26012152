<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Help Desk Ticket Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        /* Strict Monochrome & Single Regular Font Rule */
        * {
            border-radius: 0 !important;
            font-family: sans-serif !important;
            font-weight: 400 !important;
            font-style: normal !important;
            color: #000000 !important;
            box-shadow: none !important;
            text-shadow: none !important;
        }

        body {
            background-color: #ffffff !important;
            color: #000000 !important;
        }

        /* GitHub Sticker Badge */
        .github-sticker-badge {
            background-color: #ffffff !important;
            color: #000000 !important;
            border: 1px solid #000000 !important;
            padding: 0.25rem 0.6rem !important;
            font-size: 0.8rem !important;
            font-weight: 600 !important;
            display: inline-flex !important;
            align-items: center !important;
            text-decoration: none !important;
            transition: all 0.2s ease-in-out;
        }
        .github-sticker-badge:hover {
            background-color: #000000 !important;
            color: #ffffff !important;
        }
        .github-sticker-badge:hover * {
            color: #ffffff !important;
        }

        /* Navbar */
        .navbar-custom {
            background-color: #ffffff !important;
            border-bottom: 1px solid #000000 !important;
            padding-top: 0.75rem;
            padding-bottom: 0.75rem;
        }
        .navbar-brand {
            color: #000000 !important;
            font-size: 1.2rem;
            text-decoration: none;
        }
        .nav-link {
            color: #000000 !important;
            padding: 0.4rem 0.8rem !important;
            border: 1px solid #000000 !important;
            margin-right: 0.4rem;
            text-decoration: none;
        }
        .nav-link:hover {
            background-color: #000000 !important;
            color: #ffffff !important;
        }

        /* Cards & Metric Boxes */
        .card, .main-card, .metric-card {
            background-color: #ffffff !important;
            border: 1px solid #000000 !important;
        }

        /* Buttons */
        .btn {
            background-color: #ffffff !important;
            color: #000000 !important;
            border: 1px solid #000000 !important;
            text-decoration: none;
            padding: 0.375rem 0.75rem;
        }
        .btn:hover {
            background-color: #000000 !important;
            color: #ffffff !important;
        }
        .btn:hover * {
            color: #ffffff !important;
        }
        .btn-primary, .btn-secondary, .btn-success, .btn-danger, .btn-warning, .btn-info, .btn-light, .btn-outline-secondary, .btn-outline-primary {
            background-color: #ffffff !important;
            color: #000000 !important;
            border: 1px solid #000000 !important;
        }

        /* Badges */
        .badge {
            background-color: #ffffff !important;
            color: #000000 !important;
            border: 1px solid #000000 !important;
            padding: 0.25rem 0.5rem;
            display: inline-block;
        }

        /* Tables */
        .table {
            background-color: #ffffff !important;
            border: 1px solid #000000 !important;
        }
        .table th, .table td {
            border: 1px solid #000000 !important;
            background-color: #ffffff !important;
            color: #000000 !important;
        }

        /* Form Controls */
        .form-control, .form-select {
            background-color: #ffffff !important;
            border: 1px solid #000000 !important;
            color: #000000 !important;
        }
        .form-control:focus, .form-select:focus {
            background-color: #ffffff !important;
            border: 1px solid #000000 !important;
            color: #000000 !important;
        }

        /* Footer */
        footer {
            background-color: #ffffff !important;
            border-top: 1px solid #000000 !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Ticket" asp-action="Dashboard">
                    <i class="bi bi-square"></i>
                    <span>HelpDesk System</span>
                    <a href="https://github.com/srpm2005/HelpDeskManagement_IN26012152" target="_blank" class="github-sticker-badge ms-2" title="View GitHub Profile: srpm2005">
                        <i class="bi bi-github me-1"></i>
                        <span>SHRI RAM PRINCE MISHRA IN26012152</span>
                    </a>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto gap-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ticket" asp-action="Dashboard">
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ticket" asp-action="Index">
                                View All Tickets
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ticket" asp-action="Create">
                                Raise New Ticket
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ticket" asp-action="KnowledgeAssistant">
                                AI Knowledge Assistant
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert border border-dark p-3 mb-4" role="alert">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert border border-dark p-3 mb-4" role="alert">
                @TempData["ErrorMessage"]
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-4 mt-5 border-top border-dark bg-white">
        <div class="container text-center">
            <p class="mb-2">&copy; 2026 Help Desk Ticket Management System - MP Online Project</p>
            <a href="https://github.com/srpm2005/HelpDeskManagement_IN26012152" target="_blank" class="github-sticker-badge py-2 px-3 mt-1" title="Visit GitHub Repository & Profile: srpm2005">
                <i class="bi bi-github me-2 fs-5"></i>
                <span>SHRI RAM PRINCE MISHRA IN26012152</span>
            </a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
