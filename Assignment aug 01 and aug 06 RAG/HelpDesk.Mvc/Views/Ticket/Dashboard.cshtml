@model HelpDesk.Mvc.Models.DashboardViewModel
@{
    ViewData["Title"] = "Help Desk Dashboard";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Help Desk Dashboard</h2>
        <p class="text-muted mb-0">Real-time overview of internal employee support requests and resolution status.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Raise New Ticket
    </a>
</div>

<!-- Metrics Overview Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card metric-card p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-medium text-uppercase tracking-wider">Total Tickets</span>
                    <h2 class="mb-0 mt-1 fw-bold">@Model.TotalTickets</h2>
                </div>
                <div class="p-3 bg-secondary-subtle rounded-3 text-dark">
                    <i class="bi bi-ticket-perforated fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card metric-card p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-medium text-uppercase tracking-wider">Open Tickets</span>
                    <h2 class="mb-0 mt-1 fw-bold text-primary">@Model.OpenTickets</h2>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-3">
                    <i class="bi bi-envelope-open fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card metric-card p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-medium text-uppercase tracking-wider">Closed Tickets</span>
                    <h2 class="mb-0 mt-1 fw-bold text-success">@Model.ClosedTickets</h2>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-3">
                    <i class="bi bi-check2-circle fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Tickets List -->
<div class="card main-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0 fw-semibold">Recently Raised Support Tickets</h5>
        <a asp-action="Index" class="btn btn-sm">View All Tickets <i class="bi bi-arrow-right ms-1"></i></a>
    </div>

    @if (Model.RecentTickets.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Raised By</th>
                        <th>Created Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model.RecentTickets)
                    {
                        var priorityBg = ticket.Priority == "High" ? "bg-danger-subtle text-danger" : (ticket.Priority == "Medium" ? "bg-warning-subtle text-warning-emphasis" : "bg-light text-secondary");
                        var statusBg = ticket.Status == "Open" ? "bg-primary-subtle text-primary" : (ticket.Status == "In Progress" ? "bg-warning-subtle text-warning-emphasis" : "bg-success-subtle text-success");
                        <tr>
                            <td class="fw-semibold">#@ticket.Id</td>
                            <td class="fw-medium">@ticket.Title</td>
                            <td>
                                <span class="badge @priorityBg">@ticket.Priority</span>
                            </td>
                            <td>
                                <span class="badge @statusBg">@ticket.Status</span>
                            </td>
                            <td>@ticket.RaisedBy</td>
                            <td class="text-muted">@ticket.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm me-1">Details</a>
                                <a asp-action="Edit" asp-route-id="@ticket.Id" class="btn btn-sm">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 border rounded-3 bg-light-subtle">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
            <p class="mb-0 text-muted">No tickets found in system.</p>
        </div>
    }
</div>

