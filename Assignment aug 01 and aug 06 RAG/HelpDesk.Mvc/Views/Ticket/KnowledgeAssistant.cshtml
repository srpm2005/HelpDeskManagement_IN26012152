@{
    ViewData["Title"] = "AI Knowledge Assistant";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card p-4 border border-dark mb-4">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-robot fs-1"></i>
                <div>
                    <h2 class="mb-1 text-uppercase">AI Knowledge Assistant</h2>
                    <p class="mb-0 text-muted">Retrieval-Augmented Generation (RAG) Developer Onboarding System</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Preset Developer Onboarding Queries Gallery -->
<div class="card p-3 mb-4 border border-dark">
    <h5 class="mb-3 text-uppercase"><i class="bi bi-lightning-charge me-2"></i>Quick Developer Onboarding Queries</h5>
    <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-outline-dark preset-btn" data-query="What REST API endpoints exist and what are their HTTP methods?">
            🌐 REST API Endpoints
        </button>
        <button class="btn btn-outline-dark preset-btn" data-query="Explain the project architecture and multi-tier structure.">
            🏗️ Project Architecture
        </button>
        <button class="btn btn-outline-dark preset-btn" data-query="How does HelpDesk.Mvc consume the Web API?">
            🔄 MVC to Web API Service
        </button>
        <button class="btn btn-outline-dark preset-btn" data-query="How are unit tests set up with Moq and xUnit?">
            🧪 Unit Testing & Moq
        </button>
        <button class="btn btn-outline-dark preset-btn" data-query="How to run the Web API and MVC applications locally?">
            🚀 Run Applications Locally
        </button>
    </div>
</div>

<!-- Query Input Form -->
<div class="card p-4 mb-4 border border-dark">
    <h5 class="mb-3 text-uppercase"><i class="bi bi-question-square me-2"></i>Ask Question About Codebase</h5>
    <div class="input-group">
        <input type="text" id="queryInput" class="form-control form-control-lg border-dark" placeholder="e.g. How does TicketController handle ticket creation?" />
        <button class="btn btn-dark px-4" id="submitBtn" type="button">
            <i class="bi bi-search me-2"></i>Ask Assistant
        </button>
    </div>
</div>

<!-- Loading Spinner -->
<div id="loadingContainer" class="card p-4 mb-4 border border-dark text-center d-none">
    <div class="spinner-border text-dark mx-auto mb-2" role="status"></div>
    <p class="mb-0">Querying RAG Vector Database & Synthesizing Grounded Answer...</p>
</div>

<!-- Output Container -->
<div id="resultContainer" class="d-none">
    <div class="card p-4 mb-4 border border-dark">
        <h4 class="mb-3 text-uppercase border-bottom pb-2 border-dark">
            <i class="bi bi-chat-left-text me-2"></i>RAG Generated Answer
        </h4>
        <div id="answerContent" class="mb-4" style="line-height: 1.6;"></div>

        <h5 class="mb-2 text-uppercase"><i class="bi bi-bookmark-check me-2"></i>Source Citations</h5>
        <div id="citationsContainer" class="d-flex flex-wrap gap-2 mb-4"></div>

        <div class="accordion border border-dark" id="contextAccordion">
            <div class="accordion-item border-0">
                <h2 class="accordion-header" id="headingContext">
                    <button class="accordion-button collapsed bg-white text-dark border-bottom border-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapseContext">
                        <i class="bi bi-journal-code me-2"></i>Inspect Retrieved Context Snippets & Scores
                    </button>
                </h2>
                <div id="collapseContext" class="accordion-collapse collapse" data-bs-parent="#contextAccordion">
                    <div class="accordion-body p-3" id="snippetsContent"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const queryInput = document.getElementById('queryInput');
            const submitBtn = document.getElementById('submitBtn');
            const loadingContainer = document.getElementById('loadingContainer');
            const resultContainer = document.getElementById('resultContainer');
            const answerContent = document.getElementById('answerContent');
            const citationsContainer = document.getElementById('citationsContainer');
            const snippetsContent = document.getElementById('snippetsContent');

            // Preset query buttons listener
            document.querySelectorAll('.preset-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    queryInput.value = this.getAttribute('data-query');
                    executeRAGQuery();
                });
            });

            submitBtn.addEventListener('click', executeRAGQuery);
            queryInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    executeRAGQuery();
                }
            });

            function executeRAGQuery() {
                const query = queryInput.value.trim();
                if (!query) return;

                loadingContainer.classList.remove('d-none');
                resultContainer.classList.add('d-none');

                fetch('/Ticket/QueryKnowledgeAssistant', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ query: query })
                })
                .then(res => {
                    if (!res.ok) throw new Error('Failed to fetch response');
                    return res.json();
                })
                .then(data => {
                    loadingContainer.classList.add('d-none');
                    resultContainer.classList.remove('d-none');

                    // Render formatted answer
                    answerContent.innerHTML = formatMarkdownText(data.answer);

                    // Render citations
                    citationsContainer.innerHTML = '';
                    if (data.citations && data.citations.length > 0) {
                        data.citations.forEach(cit => {
                            const badge = document.createElement('span');
                            badge.className = 'badge border border-dark bg-white text-dark p-2';
                            badge.innerHTML = `<i class="bi bi-file-earmark-text me-1"></i>${cit}`;
                            citationsContainer.appendChild(badge);
                        });
                    }

                    // Render snippets
                    snippetsContent.innerHTML = '';
                    if (data.retrieved_chunks && data.retrieved_chunks.length > 0) {
                        data.retrieved_chunks.forEach((chunk, idx) => {
                            const snippetBox = document.createElement('div');
                            snippetBox.className = 'border border-dark p-3 mb-3 bg-white';
                            snippetBox.innerHTML = `
                                <div class="d-flex justify-content-between mb-2">
                                    <strong>[${idx + 1}] ${chunk.title}</strong>
                                    <span class="badge border border-dark bg-white text-dark">Score: ${chunk.score}</span>
                                </div>
                                <div class="text-muted small mb-2">File: ${chunk.source_file} (Lines ${chunk.start_line}-${chunk.end_line})</div>
                                <pre class="p-2 border border-dark bg-light text-dark mb-0" style="white-space: pre-wrap; font-family: monospace;">${escapeHtml(chunk.content)}</pre>
                            `;
                            snippetsContent.appendChild(snippetBox);
                        });
                    }
                })
                .catch(err => {
                    loadingContainer.classList.add('d-none');
                    alert('Error executing RAG query: ' + err.message);
                });
            }

            function formatMarkdownText(text) {
                if (!text) return '';
                // Simple markdown formatter for headers, bold, lists, and tables
                let html = text
                    .replace(/### (.*?)\n/g, '<h4 class="mt-3 mb-2 text-uppercase">$1</h4>')
                    .replace(/#### (.*?)\n/g, '<h5 class="mt-3 mb-2">$1</h5>')
                    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/`([^`]+)`/g, '<code class="px-1 border border-dark bg-light">$1</code>')
                    .replace(/\n\n/g, '<br><br>');

                return html;
            }

            function escapeHtml(text) {
                return text
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }
        });
    </script>
}
