@model IEnumerable<HelpDesk.Mvc.Models.Ticket>
@{
    ViewData["Title"] = "All Support Tickets";
    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Support Tickets List</h2>
        <p class="text-muted mb-0">View, filter, edit and manage employee support tickets.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Raise New Ticket
    </a>
</div>

<!-- Filter Bar -->
<div class="card main-card p-3 mb-4">
    <div class="row align-items-center">
        <div class="col-md-7">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="me-2 text-muted small fw-medium">Filter Status:</span>
                <div class="btn-group" role="group">
                    <a asp-action="Index" asp-route-status="All" class="btn btn-sm @(selectedStatus == "All" ? "btn-main" : "")">All</a>
                    <a asp-action="Index" asp-route-status="Open" class="btn btn-sm @(selectedStatus == "Open" ? "btn-main" : "")">Open</a>
                    <a asp-action="Index" asp-route-status="In Progress" class="btn btn-sm @(selectedStatus == "In Progress" ? "btn-main" : "")">In Progress</a>
                    <a asp-action="Index" asp-route-status="Closed" class="btn btn-sm @(selectedStatus == "Closed" ? "btn-main" : "")">Closed</a>
                </div>
            </div>
        </div>
        <div class="col-md-5 text-md-end mt-3 mt-md-0">
            <form method="get" asp-action="Index" class="d-inline-flex gap-2">
                <select name="status" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                    <option value="All" selected="@(selectedStatus == "All")">-- Select Status --</option>
                    <option value="Open" selected="@(selectedStatus == "Open")">Open</option>
                    <option value="In Progress" selected="@(selectedStatus == "In Progress")">In Progress</option>
                    <option value="Closed" selected="@(selectedStatus == "Closed")">Closed</option>
                </select>
                @if (selectedStatus != "All")
                {
                    <a asp-action="Index" class="btn btn-sm">Reset</a>
                }
            </form>
        </div>
    </div>
</div>

<!-- Ticket Table -->
<div class="card main-card p-4">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Raised By</th>
                        <th>Created Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var priorityBg = item.Priority == "High" ? "bg-danger-subtle text-danger" : (item.Priority == "Medium" ? "bg-warning-subtle text-warning-emphasis" : "bg-light text-secondary");
                        var statusBg = item.Status == "Open" ? "bg-primary-subtle text-primary" : (item.Status == "In Progress" ? "bg-warning-subtle text-warning-emphasis" : "bg-success-subtle text-success");
                        <tr>
                            <td class="fw-semibold">#@item.Id</td>
                            <td class="fw-medium">@item.Title</td>
                            <td class="text-muted small">
                                @(item.Description.Length > 40 ? item.Description.Substring(0, 40) + "..." : item.Description)
                            </td>
                            <td>
                                <span class="badge @priorityBg">@item.Priority</span>
                            </td>
                            <td>
                                <span class="badge @statusBg">@item.Status</span>
                            </td>
                            <td>@item.RaisedBy</td>
                            <td class="text-muted small">@item.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm" title="View Details">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm" title="Edit Ticket">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm text-danger" title="Delete Ticket">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 border rounded-3 bg-light-subtle">
            <i class="bi bi-search fs-1 text-muted d-block mb-2"></i>
            <p class="mb-0 text-muted">No matching tickets found.</p>
        </div>
    }
</div>

